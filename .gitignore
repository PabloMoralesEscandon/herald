# Herald runtime data (personal articles, reading state, exports, and vaults).
# These are anchored to the repository root so they cannot shadow source
# directories: an unanchored "vault/" also matches internal/vault/, which would
# quietly drop that package from a commit and break the build for anyone
# cloning the repository.
.herald/
*.db*
*.sqlite*
*.sqlite3*
/vault/
/obsidian-archive/
/exports/
/source-exports/
/herald-sources.json

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.pypirc
.npmrc

# Go build output, test artifacts, and local tooling
/herald
/herald.exe
/dist/
/build/
*.test
*.out
coverage.txt
coverage.html
.direnv/

# Logs, temporary files, editors, and operating systems
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
