# Herald does not read .env files automatically. Copy this file to .env, edit
# it locally, then load it in your shell (for example: set -a; . ./.env; set +a).
# .env is ignored by Git; this example contains no secrets.

HERALD_DATA_DIR=.herald
HERALD_DATABASE=.herald/herald.db
HERALD_VAULT=.herald/vault
HERALD_HOST=127.0.0.1
HERALD_PORT=8765

# Optional local Ollama services. Herald falls back to non-AI local methods when
# Ollama or these models are unavailable.
HERALD_OLLAMA_URL=http://127.0.0.1:11434
HERALD_OLLAMA_MODEL=qwen2.5:3b
HERALD_OLLAMA_EMBEDDING_MODEL=embeddinggemma
